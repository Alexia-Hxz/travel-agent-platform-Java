# 后端环境变量（复制成 .env 后填写；.env 不提交）
# 数据库（R3 已确认：MySQL 8）
DB_URL=jdbc:mysql://127.0.0.1:3306/travel_agent?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=root
DB_PASSWORD=root

# 模型服务（必填）
DASHSCOPE_API_KEY=
# 可选，默认 qwen3.7-plus（与原项目一致）
PLANNING_MODEL_NAME=
# 向量化模型，默认 text-embedding-v4
EMBEDDING_MODEL_NAME=

# 图片服务（可选；不填则地点只有占位图）
PEXELS_API_KEY=

# token 签名密钥（生产必须设置；不设置时用内置开发密钥，任何 restart 都不会让 token 失效，
# 但源码公开意味着任何人都能给任意账号签 token）
AUTH_SECRET_KEY=

# 图片 CDN 兜底（可选），格式：images.pexels.com=104.18.66.220|172.64.147.160
IMAGE_HOST_FALLBACKS=

# 检索素材缓存有效期（小时）
CATEGORY_MATERIAL_CACHE_TTL_HOURS=24
# 规划任务并发数
PLANNING_JOB_WORKERS=2

# 向量库（Milvus）
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
